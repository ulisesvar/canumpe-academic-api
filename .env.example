# Copy to .env and fill in real values. Never commit the real .env file.

# --- API's own database (API keys, student identity mapping, audit metadata) ---
API_DB_URL=postgresql+psycopg://academic_api:changeme@api-db:5432/canumpe_academic_api

# --- Source systems (read-only credentials only) ---
ATTENDANCE_DB_URL=postgresql+psycopg://academic_api_attendance:changeme@attendance-db:5432/asistencia
MOODLE_DB_URL=postgresql+psycopg://academic_api_moodle:changeme@moodle-db:5432/moodle

# --- Security ---
# Optional pepper mixed into the API key hash. Rotating it invalidates all existing keys.
API_KEY_HASH_PEPPER=changeme-random-pepper

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=production
RATE_LIMIT_PER_MINUTE=60
